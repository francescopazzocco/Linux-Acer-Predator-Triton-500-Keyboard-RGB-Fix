[Unit]
Description=Restore per-key RGB colors on boot and resume
After=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target fix-keyboard.service
Wants=fix-keyboard.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/perkey_rgb.py --replay --wait 10

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
